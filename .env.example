# Copy to .env.preprod and fill in. NEVER commit the filled file.
# Preprod network endpoints
MIDNIGHT_NETWORK_ID=preprod
MIDNIGHT_NODE_URL=https://rpc.preprod.midnight.network
MIDNIGHT_INDEXER_URL=https://indexer.preprod.midnight.network
MIDNIGHT_PROOF_SERVER_URL=http://127.0.0.1:6300
# Wallet seed (funded with tNIGHT + DUST from the preprod faucet:
# https://faucet.preprod.midnight.network/)
WALLET_SEED=
# Backend gate for privileged API calls AND the on-chain governor secret
# (its commitment is written by initGovernor at deploy). Must match between
# backend and deploy. Default "sealml-local-admin" is local-dev only.
ADMIN_SECRET=sealml-local-admin
# WebSocket indexer endpoint (defaults to http->ws conversion of the above)
MIDNIGHT_INDEXER_WS_URL=
# Encrypted private-state store used by deploy + operate paths
PRIVATE_STATE_PASSWORD=sealml-local-state
PRIVATE_STATE_ACCOUNT_ID=sealml
# Deployed contract addresses (written by npm run deploy:preprod)
MODEL_REGISTRY_ADDRESS=
DATASET_REGISTRY_ADDRESS=
EVALUATOR_REGISTRY_ADDRESS=
EVALUATION_REGISTRY_ADDRESS=
CERTIFICATION_REGISTRY_ADDRESS=
REVOCATION_REGISTRY_ADDRESS=
# Server
PORT=3000
# Local ledger mirror file (offline cache; chain is source of truth when configured)
LEDGER_FILE=./data/ledger.json
