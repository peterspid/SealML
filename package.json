{
  "name": "sealml",
  "version": "1.0.0",
  "description": "SealML — privacy-preserving AI certification platform on Midnight",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build -c frontend/vite.config.mjs && node scripts/build-frontend-assets.mjs",
    "start": "node dist/backend/src/index.js",
    "dev": "node --watch dist/backend/src/index.js",
    "compile:contracts": "bash scripts/compile-contracts.sh",
    "test": "node --test test/*.test.mjs",
    "deploy:preprod": "node scripts/deploy-preprod.mjs"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "^0.16.0",
    "@midnight-ntwrk/midnight-js": "^4.1.1",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "^4.1.1",
    "@midnight-ntwrk/wallet": "^5.0.0",
    "dotenv": "^16.4.5",
    "effect": "^3.22.2",
    "express": "^4.19.2",
    "rxjs": "^7.8.2",
    "vite": "^7.1.12"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.0",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.1",
    "events": "^3.3.0",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "typescript": "^5.4.5",
    "util": "^0.12.5",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
